# Dependencies, build output, and tool caches.
node_modules/
out/
# Compiled runtime and macOS x64/arm64 packages.
/dist/
.vite/
.vitest/
.cache/
*.tsbuildinfo

# Disposable test reports.
coverage/
playwright-report/
test-results/

# Package manager diagnostic logs (not all *.log files).
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Python bytecode and editor/OS temporary files.
__pycache__/
*.pyc
*.pyo
*.swp
*.swo
*~
.DS_Store

# Local Pi/Hub state and environment files, never project source.
.pi/
.pi-hub/
.env
.env.*
!.env.example

# Local specifications, tasks, and verification evidence.
/.scratch/
